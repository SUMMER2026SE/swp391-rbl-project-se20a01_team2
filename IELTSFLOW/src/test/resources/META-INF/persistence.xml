<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" 
             xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="IELTSFLOW_TEST" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>model.CandidateTarget</class>
    <class>model.SubscriptionPackage</class>
    <class>model.SystemLog</class>
    <class>model.Transaction</class>
    <class>model.Exam</class>
    <class>model.Lesson</class>
    <class>model.Notification</class>
    <class>model.Pathway</class>
    <class>model.Ticket</class>
    <class>model.TicketReply</class>
    <class>model.User</class>
    <class>model.UserLessonProgress</class>
    <class>model.UserQuestionBookmark</class>
    <class>model.WeeklyPlan</class>
    <class>model.QuestionResource</class>
    <class>model.Question</class>
    <class>model.Answer</class>
    <class>model.Tag</class>
    <class>model.UserSubscription</class>
    <class>model.AIEvaluation</class>
    <class>model.FeedbackMistake</class>
    <class>model.FeedbackSpeaking</class>
    <class>model.FeedbackWriting</class>
    <class>model.PronunciationResult</class>
    <class>model.SubmissionDetail</class>
    <class>model.TestSubmission</class>
    <class>model.UploadedFile</class>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>NONE</validation-mode>
    <properties>
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.show_sql" value="true"/>
      <!-- Create tables automatically for tests -->
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
    </properties>
  </persistence-unit>
</persistence>
