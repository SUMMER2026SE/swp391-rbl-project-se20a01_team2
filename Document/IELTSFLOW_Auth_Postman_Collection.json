      "name": "8. Auth",
      "item": [
        {
          "name": "Auth - Happy Path (Forward to login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response should be auth page\", function () { \r",
                  "    if (pm.response.code === 200) { \r",
                  "        pm.expect(pm.response.text()).to.include(\"Xác thực - IELTSFlow\");\r",
                  "    } \r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Lấy URL thực tế sau khi đã thay thế các biến\r",
                  "const resolvedUrlStr = pm.variables.replaceIn(pm.request.url.toString());\r",
                  "\r",
                  "// 2. Dùng Regex để tách lấy tên miền gốc (host)\r",
                  "const match = resolvedUrlStr.match(/^https?:\\/\\/([^/?#]+)(?:[/?#]|$)/i);\r",
                  "let actualHost = \"localhost\"; // Mặc định dự phòng\r",
                  "\r",
                  "if (match && match[1]) {\r",
                  "    actualHost = match[1];\r",
                  "    // Bỏ cổng (port) đi nếu có (VD: localhost:8080 -> localhost)\r",
                  "    actualHost = actualHost.split(':')[0]; \r",
                  "}\r",
                  "\r",
                  "const jar = pm.cookies.jar();\r",
                  "\r",
                  "// 3. Xóa cookie\r",
                  "jar.clear(actualHost, function (error) {\r",
                  "    if (error) {\r",
                  "        console.error(\"Failed to clear cookies for \" + actualHost + \":\", error);\r",
                  "    } else {\r",
                  "        console.log(\"Cookies cleared successfully for \" + actualHost);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "action",
                  "value": "login",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
