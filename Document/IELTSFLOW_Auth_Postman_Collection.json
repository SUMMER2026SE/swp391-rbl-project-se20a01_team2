                            }
                        }
                    ]
                },
                {
                    "name": "Login - Negative (Invalid Email Format)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "email",
                                    "value": "not-an-email",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "Password@123",
                                    "type": "text"
                                }
                            ]
