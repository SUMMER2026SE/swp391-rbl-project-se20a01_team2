                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Should reject invalid email format\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "3. Google Auth",
            "item": [
                {
                    "name": "Google Auth - Happy Path",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/auth/google",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "google"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200 or 302 Redirect\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                                    "});",
                                    "pm.test(\"Should redirect to Google OAuth URL (if 302)\", function () {",
                                    "    if (pm.response.code === 302) {",
                                    "        pm.response.to.have.header(\"Location\");",
                                    "        pm.expect(pm.response.headers.get(\"Location\")).to.include(\"accounts.google.com\");",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "4. Logout",
            "item": [
                {
                    "name": "Logout - Happy Path",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200 OK or 302 Redirect (to login)\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                                    "});",
                                    "pm.test(\"JSESSIONID Cookie is cleared or expired\", function () {",
                                    "    let setCookieHeader = pm.response.headers.get(\"Set-Cookie\");",
                                    "    if (setCookieHeader && setCookieHeader.includes(\"JSESSIONID\")) {",
                                    "        pm.expect(setCookieHeader).to.match(/Max-Age=0|Expires=.*1970/);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Logout - Negative (No Session)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Should redirect to login if no session exists\", function () {",
                                    "     pm.expect(pm.response.code).to.be.oneOf([302, 401]);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        }
    ]
