    {
      "name": "6. Change Password",
      "item": [
        {
          "name": "Change Password - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Return success message\", function () {\r",
                  "     pm.expect(pm.response.text()).to.include(\"Cập nhật mật khẩu thành công\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "\r",
                  "// 2. Chạy tự động khôi phục mật khẩu nếu đổi thành công\r",
                  "if (pm.response.code === 200 || pm.response.code === 302) {\r",
                  "    const baseUrl = pm.variables.get(\"base_url\") || \"http://localhost:8080/IELTSFLOW\";\r",
                  "    // Cấu hình request để khôi phục (đổi ngược lại)\r",
                  "    const restoreRequest = {\r",
                  "        url: baseUrl + \"/change-password\",\r",
                  "        method: 'POST',\r",
                  "        header: {\r",
                  "            'Content-Type': 'application/x-www-form-urlencoded'\r",
                  "        },\r",
                  "        body: {\r",
                  "            mode: 'urlencoded',\r",
                  "            urlencoded: [\r",
                  "                // currentPassword = Mật khẩu mới vừa đổi ở tab Body\r",
                  "                { key: \"currentPassword\", value: \"newPass123\" }, \r",
                  "                \r",
                  "                // newPassword = Mật khẩu gốc ban đầu của bạn (VD: Password@123)\r",
                  "                { key: \"newPassword\", value: \"Password@123\" },   \r",
                  "                { key: \"confirmPassword\", value: \"Password@123\" }\r",
                  "            ]\r",
                  "        }\r",
                  "    };\r",
                  "    // Gửi request khôi phục trong nền\r",
                  "    pm.sendRequest(restoreRequest, function (err, res) {\r",
                  "        if (err) {\r",
                  "            console.error(\"Password restore failed:\", err);\r",
                  "        } else {\r",
                  "            console.log(\"Password restored successfully back to original!\");\r",
                  "        }\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Lấy base_url từ variables\r",
                  "const baseUrl = pm.variables.get(\"base_url\");\r",
                  "\r",
                  "// Cấu hình request tự động đăng nhập\r",
                  "const loginRequest = {\r",
                  "    url: baseUrl + \"/api/auth/login\",\r",
                  "    method: 'POST',\r",
                  "    header: {\r",
                  "        'Content-Type': 'application/x-www-form-urlencoded'\r",
                  "    },\r",
                  "    body: {\r",
                  "        mode: 'urlencoded',\r",
                  "        urlencoded: [\r",
                  "            // Thay đổi bằng thông tin của tài khoản có sẵn trong DB của bạn\r",
                  "            { key: \"email\", value: \"changeme@tanmanh350.ovh\" }, \r",
                  "            \r",
                  "            // Mật khẩu này phải giống với 'currentPassword' ở tab Body của Change Password\r",
                  "            { key: \"password\", value: \"Password@123\" } \r",
                  "        ]\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "// Gửi request\r",
                  "pm.sendRequest(loginRequest, function (err, res) {\r",
                  "    if (err) {\r",
                  "        console.error(\"Auto-login failed:\", err);\r",
                  "    } else {\r",
                  "        // Nếu HTTP Status code trả về 200 hoặc 302\r",
                  "        if (res.code === 200 || res.code === 302) {\r",
                  "            console.log(\"Auto-login successful! JSESSIONID is set in Postman's cookie jar.\");\r",
                  "        } else {\r",
                  "            console.warn(\"Auto-login might have failed. HTTP Status:\", res.code);\r",
                  "        }\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "currentPassword",
                  "value": "Password@123",
