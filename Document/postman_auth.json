{
  "info": {
    "name": "IELTSFLOW - Part 1: Authentication & User Management",
    "description": "Bộ test Postman cho các tính năng xác thực: Đăng ký, Đăng nhập, Đổi mật khẩu. Bao gồm cả Happy Path và Negative Path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Check success message or redirect\", function () {",
                  "    var bodyText = pm.response.text();",
                  "    pm.expect(bodyText).to.include(\"kiểm tra hộp thư email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "fullName", "value": "Test User", "type": "text" },
                { "key": "email", "value": "testuser{{$randomInt}}@gmail.com", "type": "text" },
                { "key": "password", "value": "StrongPass123!", "type": "text" },
                { "key": "confirmPassword", "value": "StrongPass123!", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Register - Negative Path (Weak Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (returns to form)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Shows password error message\", function () {",
                  "    var bodyText = pm.response.text();",
                  "    pm.expect(bodyText).to.include(\"Mật khẩu phải có ít nhất 8 ký tự\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "fullName", "value": "Test User", "type": "text" },
                { "key": "email", "value": "test@gmail.com", "type": "text" },
                { "key": "password", "value": "weak", "type": "text" },
                { "key": "confirmPassword", "value": "weak", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Successful login redirects or returns 200 if followed\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "pm.test(\"Check session cookie is set\", function () {",
                  "    pm.expect(pm.cookies.has('JSESSIONID')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "admin@ieltsflow.com", "type": "text" },
                { "key": "password", "value": "Admin123!", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Negative Path (Wrong Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (returns to login form)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Shows error message\", function () {",
                  "    var bodyText = pm.response.text();",
                  "    pm.expect(bodyText).to.include(\"Sai mật khẩu\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "admin@ieltsflow.com", "type": "text" },
                { "key": "password", "value": "WrongPassword123!", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 302\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/IELTSFLOW",
      "type": "string"
    }
  ]
}
