{
  "info": {
    "name": "IELTSFLOW - Part 3: Admin & Mentor Module",
    "description": "Bộ test Postman cho các tính năng của Quản trị viên (Admin) và Giảng viên (Mentor).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "3. Admin Features",
      "item": [
        {
          "name": "Admin - Get Users List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Admin - Ban User (API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Verify success response\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"action\": \"ban\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/ban",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "ban"]
            }
          }
        },
        {
          "name": "Admin - Unban User (API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"action\": \"unban\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/ban",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "ban"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Mentor Features",
      "item": [
        {
          "name": "Mentor - Get Questions List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mentor/questions?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["mentor", "questions"],
              "query": [
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Mentor - Create Question (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Created successfully (redirects or 200)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "action", "value": "create", "type": "text" },
                { "key": "skill", "value": "Listening", "type": "text" },
                { "key": "difficulty", "value": "Easy", "type": "text" },
                { "key": "type", "value": "MultipleChoice", "type": "text" },
                { "key": "content", "value": "This is a test question", "type": "text" },
                { "key": "contentJSON", "value": "{\"options\":[\"A\",\"B\"]}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/mentor/questions",
              "host": ["{{baseUrl}}"],
              "path": ["mentor", "questions"]
            }
          }
        },
        {
          "name": "Mentor - Delete Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Delete successful\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "action", "value": "delete", "type": "text" },
                { "key": "questionId", "value": "999", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/mentor/questions",
              "host": ["{{baseUrl}}"],
              "path": ["mentor", "questions"]
            }
          }
        },
        {
          "name": "Mentor - Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mentor/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["mentor", "dashboard"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/IELTSFLOW",
      "type": "string"
    }
  ]
}
