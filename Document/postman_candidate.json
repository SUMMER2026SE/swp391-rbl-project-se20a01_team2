{
  "info": {
    "name": "IELTSFLOW - Part 2: Candidate Module",
    "description": "Bộ test Postman cho các tính năng của người học (Candidate): Đặt mục tiêu, Lộ trình, Mock Test, Placement Test, và Hỏi đáp (Ticket).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "2. Candidate Features",
      "item": [
        {
          "name": "Goal API - Set Target (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is valid JSON\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "currentBand", "value": "5.5", "type": "text" },
                { "key": "targetBand", "value": "7.5", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/goal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "goal"]
            }
          }
        },
        {
          "name": "Goal API - Set Invalid Target (Negative Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error message is returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "currentBand", "value": "5.5", "type": "text" },
                { "key": "targetBand", "value": "10.0", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/goal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "goal"]
            }
          }
        },
        {
          "name": "Goal API - Get Target",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/goal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "goal"]
            }
          }
        },
        {
          "name": "Ticket - Create New Ticket (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Successful creation redirects\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "action", "value": "create", "type": "text" },
                { "key": "subject", "value": "Cần hỗ trợ về Reading", "type": "text" },
                { "key": "content", "value": "Câu 5 phần Matching em không hiểu tại sao lại sai ạ.", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/candidate/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["candidate", "tickets"]
            }
          }
        },
        {
          "name": "Ticket - Get My Tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Verify page loads\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"hỗ trợ\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/candidate/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["candidate", "tickets"]
            }
          }
        },
        {
          "name": "Mock Test - Start Test (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Start test successful (returns 200/302)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "action", "value": "start", "type": "text" },
                { "key": "examId", "value": "1", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/candidate/mock-test",
              "host": ["{{baseUrl}}"],
              "path": ["candidate", "mock-test"]
            }
          }
        },
        {
          "name": "Mock Test - Register Violation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Violation registered successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "action", "value": "violation", "type": "text" },
                { "key": "submissionId", "value": "1", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/candidate/mock-test",
              "host": ["{{baseUrl}}"],
              "path": ["candidate", "mock-test"]
            }
          }
        },
        {
          "name": "Candidate Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/candidate/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["candidate", "dashboard"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/IELTSFLOW",
      "type": "string"
    }
  ]
